# ── Local dev / Docker / Cloud Run environment configuration ─────────────────
# Copy to server/.env for local development. In Cloud Run, pass config via env
# vars and secrets via Secret Manager (or use deploy/cloudrun-setup.ps1 / .sh).

PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ── PostgreSQL / Cloud SQL (use ONE of the three connection modes below) ───────
# Option 1: Connection URL (local Postgres / Docker / Cloud SQL Auth Proxy)
DATABASE_URL=postgres://postgres:replace-with-local-db-password@localhost:5432/gtm_chat_history

# Option 2: Cloud Run native Cloud SQL Unix socket (recommended in Cloud Run)
# INSTANCE_CONNECTION_NAME=your-gcp-project:us-central1:gtm-auditor-db
# DB_USER=gtm_app
# DB_PASSWORD=replace-with-secret-manager-password
# DB_NAME=gtm_chat_history

# Option 3: Discrete TCP Postgres env vars (Docker Compose / external Postgres)
# DB_HOST=postgres
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=gtm_chat_history
# DB_SSL=false

# ── Startup Bootstrap Behavior ─────────────────────────────────────────────────
AUTO_INIT_DB=true
AUTO_SEED_CONTAINER=true
AUTO_CREATE_BUCKETS=false

# ── GCP Project, Credentials & Storage ─────────────────────────────────────────
# In Cloud Run, Project ID and ADC credentials are detected automatically.
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# Optional outside GCP: set GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json
# OR inline raw/Base64 JSON via GCP_SERVICE_ACCOUNT_JSON or GCP_SERVICE_ACCOUNT_JSON_B64
# GOOGLE_APPLICATION_CREDENTIALS=
# GCP_SERVICE_ACCOUNT_JSON=
# GCP_SERVICE_ACCOUNT_JSON_B64=

# Defaults to <projectId>-gtm-container and <projectId>-chat-files if omitted;
# set FILES_BUCKET=none to run without GCS file storage.
CONTAINER_BUCKET=your-gcp-project-gtm-container
FILES_BUCKET=your-gcp-project-chat-files

# ── Application Secrets (use Secret Manager in Cloud Run) ──────────────────────
TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-char-random-secret
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Optional fallback if private bucket storage is unavailable:
# IMG_BB_API_KEY=your-imgbb-api-key
